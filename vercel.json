{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "redirects": [
    { "source": "/tonight", "destination": "/", "permanent": true },
    { "source": "/map", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org https://unpkg.com; connect-src 'self' https://*.supabase.co https://nominatim.openstreetmap.org; upgrade-insecure-requests" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/night/:slug", "destination": "/night/:slug.html" },
    { "source": "/comedy/:area", "destination": "/comedy/:area.html" },
    { "source": "/comedy", "destination": "/comedy.html" },
    { "source": "/guides/:slug", "destination": "/guides/:slug.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/submit", "destination": "/submit.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/my", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/((?!_vercel/).*)", "destination": "/index.html" }
  ]
}
