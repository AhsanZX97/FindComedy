# Supabase — get these from your project's Settings > API page.
# The anon key is safe to embed in the browser bundle; RLS is the security layer.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Ahrefs Web Analytics — the public data-key from your Ahrefs Web Analytics project.
# Set in the Vercel project so it's baked into the build; leave unset to skip the tag
# (local dev / preview). Safe to expose: it ships in the client bundle by design.
VITE_AHREFS_ANALYTICS_KEY=your-ahrefs-web-analytics-key
